# ---- Database (Neon free Postgres). Leave as sqlite for quick local dev ----
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please
GOOGLE_CLIENT_ID=

# ---- First admin account (created on startup if both are set) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Optional free API keys ----
TOMTOM_API_KEY=

# ---- Free keyless services (defaults are fine) ----
OSRM_URL=https://router.project-osrm.org
USER_AGENT=RideGuard/1.0 (contact: you@example.com)

# ---- App behaviour ----
CORS_ORIGINS=*
STREAM_MODE=queue        # queue = background worker (Kafka-style), inline = process immediately
FRAUD_ALERT_THRESHOLD=0.6
